# Copy to backend/.env and fill in. Nothing here is required to try the demo.

# Claude. Without a key, a built-in rule engine answers (same tools, same safety rules).
ANTHROPIC_API_KEY=
# DAKBOX_MODEL=claude-sonnet-5-5
# DAKBOX_SUMMARY_MODEL=claude-haiku-5-5

# Meta channels are connected in the app (Connections, Channels); tokens are stored encrypted.
# In production set the key yourself so it lives apart from the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DAKBOX_SECRET_KEY=
# META_GRAPH_VERSION=v26.0
# PUBLIC_URL=https://your-domain        # can also be set in the app

# "production" hides /api/docs, restricts CORS and refuses unsigned webhooks.
# DAKBOX_ENV=production
# Extra browser origins allowed to call the API in production (comma separated). Same-origin needs none.
# DAKBOX_ORIGINS=

# Couriers and payments are connected in the app (Connections, Couriers / Payments); credentials are stored encrypted.
# Real gateways need a public https PUBLIC_URL (above). These overrides exist ONLY to point at the local stand-in
# (backend/tools/fake_providers_server.py); leave them unset for real providers, where the hosts are locked to the real domains.
# SSLCOMMERZ_BASE=http://127.0.0.1:4011
# BKASH_BASE=http://127.0.0.1:4011
# AAMARPAY_BASE=http://127.0.0.1:4011
# STEADFAST_BASE=http://127.0.0.1:4011

# SMS providers are connected in the app (Connections, SMS). Stand-in overrides, same rule as above:
# SSLWIRELESS_BASE=http://127.0.0.1:4011/api/v3
# ALPHASMS_BASE=http://127.0.0.1:4011
